# Copia in supabase/functions/.env per `supabase functions serve`.
# In produzione: supabase secrets set --env-file supabase/functions/.env

# BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456:ABC...
# Obbligatorio: la passiamo a setWebhook e Telegram la rimanda in ogni chiamata.
# Senza, il webhook rifiuta tutto.
TELEGRAM_WEBHOOK_SECRET=cambiami
# Chat autorizzate (le due chat private, o un gruppo), separate da virgola.
# Vuoto = il bot non risponde a nessuno. Per scoprire un id: scrivi /start al bot
# da una chat non ancora autorizzata, risponde con il numero.
TELEGRAM_ALLOWED_CHAT_IDS=

# console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Recap mattutino (l'ora è fissa alle 8 di Roma: vedi daily-recap/index.ts e cron.sql)
CRON_SECRET=cambiami-anche-questo

# Solo per test: punta il client Telegram a un server finto
# TELEGRAM_API_BASE=http://localhost:9999

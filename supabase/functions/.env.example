# Copia in supabase/functions/.env per `supabase functions serve`.
# In produzione: supabase secrets set --env-file supabase/functions/.env

# BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456:ABC...
# Stringa a tua scelta, la passiamo a setWebhook e Telegram la rimanda in ogni chiamata
TELEGRAM_WEBHOOK_SECRET=cambiami
# Chat in cui il bot lavora (gruppo, oppure le due chat private separate da virgola).
# Lascia vuoto la prima volta e scrivi /id al bot per scoprirlo.
TELEGRAM_ALLOWED_CHAT_IDS=

# console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Recap mattutino
CRON_SECRET=cambiami-anche-questo
RECAP_HOUR=8

# Solo per test: punta il client Telegram a un server finto
# TELEGRAM_API_BASE=http://localhost:9999
